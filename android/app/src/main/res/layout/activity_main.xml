<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Full-screen Monzi 2.0 WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Subtle Floating Native Companion Gear Button -->
    <ImageButton
        android:id="@+id/btnNativeSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:contentDescription="Native SMS Settings"
        android:elevation="6dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_preferences" />

    <!-- Collapsible Native Companion Settings Overlay -->
    <ScrollView
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60F172A"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Monzi Android Bridge"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E2E8F0"
                    android:text="Close"
                    android:textColor="#0F172A"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#F1F5F9"
                android:padding="12dp"
                android:text="Status: Checking SMS permissions..."
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#2563EB"
                android:text="Grant SMS Permissions"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync API URL:"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="https://ara20.vercel.app/api/sync"
                android:inputType="textUri"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Sync Token (auto-filled when signed in):"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSyncToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Auto-populated from logged-in account"
                android:inputType="text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optional Server Sync Secret (x-monzi-secret):"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Optional MONZI_SYNC_SECRET"
                android:inputType="textPassword"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#0F172A"
                android:text="Save Settings"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnScanHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#16A34A"
                android:text="Scan Historical SMS (Last 500)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnReloadWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E2E8F0"
                android:text="Reload Monzi Web App"
                android:textColor="#0F172A" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
