<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monzi 2.0"
        android:textColor="#0F172A"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Android SMS Companion"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:text="Status: Checking permissions..."
        android:textColor="#2563EB"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#2563EB"
        android:padding="12dp"
        android:text="Grant SMS Permissions"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync Server URL:"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="https://your-monzi.vercel.app/api/sync"
        android:inputType="textUri"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync Secret Token:"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSecret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="monzi_sec_live_9921_dev"
        android:inputType="textPassword"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#0F172A"
        android:text="Save Settings"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnScanHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#16A34A"
        android:text="Scan Historical SMS"
        android:textColor="#FFFFFF" />

</LinearLayout>
